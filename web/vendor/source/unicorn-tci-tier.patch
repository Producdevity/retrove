--- a/qemu/tcg/tci.c
+++ b/qemu/tcg/tci.c
@@ -478,6 +478,8 @@
 uintptr_t tci_tb_ptr;
 #endif
 
+#include "retrove-tier.h"
+
 /* Interpret pseudo code in tb. */
 uintptr_t tcg_qemu_tb_exec(CPUArchState *env, uint8_t *tb_ptr)
 {
@@ -490,6 +492,12 @@
     regs[TCG_REG_CALL_STACK] = sp_value;
     tci_assert(tb_ptr);
 
+retrove_next_block:
+    {
+        int status = retrove_dispatch(regs, &tb_ptr, &ret);
+        if (status > 0) return ret;
+        if (status == 0) goto retrove_next_block;
+    }
     for (;;) {
         TCGOpcode opc = tb_ptr[0];
 #if defined(CONFIG_DEBUG_TCG) && !defined(NDEBUG)
@@ -511,7 +519,7 @@
 #endif
         TCGMemOpIdx oi;
 
-#if defined(GETPC)
+#if defined(CONFIG_TCG_INTERPRETER)
         tci_tb_ptr = (uintptr_t)tb_ptr;
 #endif
 
@@ -1123,7 +1131,7 @@
             tb_ptr += sizeof(int32_t);
             tci_assert(tb_ptr == old_code_ptr + op_size);
             tb_ptr += (int32_t)t0;
-            continue;
+            goto retrove_next_block;
         case INDEX_op_qemu_ld_i32:
             t0 = *tb_ptr++;
             taddr = tci_read_ulong(regs, &tb_ptr);
--- a/qemu/accel/tcg/translate-all.c
+++ b/qemu/accel/tcg/translate-all.c
@@ -1344,6 +1344,11 @@
 #endif
 
 /* flush all the translation blocks */
+#ifdef CONFIG_TCG_INTERPRETER
+void retrove_tci_register(void *code, uint32_t size);
+void retrove_tci_reset(void);
+#endif
+
 static void do_tb_flush(CPUState *cpu, run_on_cpu_data tb_flush_count)
 {
     mmap_lock();
@@ -1374,6 +1379,9 @@
     qht_reset_size(cpu->uc, &cpu->uc->tcg_ctx->tb_ctx.htable, CODE_GEN_HTABLE_SIZE);
     page_flush_tb(cpu->uc);
 
+#ifdef CONFIG_TCG_INTERPRETER
+    retrove_tci_reset();
+#endif
     tcg_region_reset_all(cpu->uc->tcg_ctx);
     /* XXX: flush processor icache at this point if cache flush is
        expensive */
@@ -1857,6 +1865,9 @@
         tcg_ctx->code_gen_ptr = (void *)orig_aligned;
         return existing_tb;
     }
+#ifdef CONFIG_TCG_INTERPRETER
+    retrove_tci_register(tb->tc.ptr, tb->tc.size);
+#endif
     tcg_tb_insert(tcg_ctx, tb);
     return tb;
 }
